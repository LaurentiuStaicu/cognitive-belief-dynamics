{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laurentiustaicu.github.io/cognitive-epistemic-model/schemas/decision_uncertainty.schema.json",
  "title": "CEM Decision Under Uncertainty registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "baseline_artifact",
    "probability_policy",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "registry_id": {"const": "OA6.UNCERTAINTY.REGISTRY.V1"},
    "baseline_artifact": {"const": "web/public/model/interventions.json"},
    "probability_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finite_scenarios_default",
        "infer_probabilities",
        "expected_value_requires_explicit_probabilities"
      ],
      "properties": {
        "finite_scenarios_default": {"const": "NOT_AVAILABLE"},
        "infer_probabilities": {"const": false},
        "expected_value_requires_explicit_probabilities": {"const": true}
      }
    },
    "uncertainties": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/uncertainty"}
    }
  },
  "$defs": {
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ro", "en"],
      "properties": {
        "ro": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "label": {"$ref": "#/$defs/copy"},
        "value": {"type": "number"}
      }
    },
    "boundedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "unit"],
      "properties": {
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "probabilityDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "probabilities"],
      "properties": {
        "support": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "number"}
        },
        "probabilities": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role",
        "uncertainty_type",
        "target_ids",
        "source_kind",
        "source_refs",
        "quantification_status",
        "probability_status",
        "reducibility",
        "decision_relevance",
        "limitations"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^UNC\\.[A-Z0-9_.-]+$"},
        "label": {"$ref": "#/$defs/copy"},
        "role": {
          "enum": ["SCIENTIFIC_UNCERTAINTY", "DECISION_ASSUMPTION"]
        },
        "uncertainty_type": {
          "enum": [
            "PARAMETER",
            "STRUCTURAL",
            "EVIDENCE",
            "SCENARIO",
            "PREFERENCE",
            "IMPLEMENTATION",
            "MEASUREMENT"
          ]
        },
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_kind": {
          "enum": [
            "MODEL_ARTIFACT",
            "USER_INPUT",
            "RESEARCH_CONTRACT",
            "EXTERNAL_EVIDENCE"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "quantification_status": {
          "enum": [
            "QUALITATIVE",
            "BOUNDED_RANGE",
            "FINITE_SCENARIOS",
            "PROBABILITY_DISTRIBUTION"
          ]
        },
        "probability_status": {
          "enum": [
            "NOT_AVAILABLE",
            "USER_DECLARED",
            "EMPIRICALLY_ESTIMATED",
            "MODEL_DERIVED"
          ]
        },
        "reducibility": {
          "enum": [
            "REDUCIBLE_BY_DATA",
            "USER_CONTROLLED",
            "PARTLY_REDUCIBLE",
            "NOT_READILY_REDUCIBLE"
          ]
        },
        "decision_relevance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "RANKING",
              "FEASIBILITY",
              "OBJECTIVE",
              "TIMING",
              "COST",
              "MODEL_SCOPE"
            ]
          }
        },
        "limitations": {"$ref": "#/$defs/copy"},
        "finite_scenarios": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scenario"}
        },
        "scenario_probabilities": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "bounded_range": {"$ref": "#/$defs/boundedRange"},
        "probability_distribution": {"$ref": "#/$defs/probabilityDistribution"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"role": {"const": "DECISION_ASSUMPTION"}},
            "required": ["role"]
          },
          "then": {
            "properties": {
              "uncertainty_type": {
                "enum": ["SCENARIO", "PREFERENCE", "IMPLEMENTATION"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"quantification_status": {"const": "FINITE_SCENARIOS"}},
            "required": ["quantification_status"]
          },
          "then": {"required": ["finite_scenarios"]}
        },
        {
          "if": {
            "properties": {"quantification_status": {"const": "BOUNDED_RANGE"}},
            "required": ["quantification_status"]
          },
          "then": {"required": ["bounded_range"]}
        },
        {
          "if": {
            "properties": {"quantification_status": {"const": "QUALITATIVE"}},
            "required": ["quantification_status"]
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["finite_scenarios"]},
                {"required": ["scenario_probabilities"]},
                {"required": ["bounded_range"]},
                {"required": ["probability_distribution"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {"quantification_status": {"const": "PROBABILITY_DISTRIBUTION"}},
            "required": ["quantification_status"]
          },
          "then": {
            "required": ["probability_distribution"],
            "properties": {
              "probability_status": {
                "enum": [
                  "USER_DECLARED",
                  "EMPIRICALLY_ESTIMATED",
                  "MODEL_DERIVED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"probability_status": {"const": "NOT_AVAILABLE"}},
            "required": ["probability_status"]
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["scenario_probabilities"]},
                {"required": ["probability_distribution"]}
              ]
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {"quantification_status": {"const": "FINITE_SCENARIOS"}},
                "required": ["quantification_status"]
              },
              {
                "not": {
                  "properties": {"probability_status": {"const": "NOT_AVAILABLE"}},
                  "required": ["probability_status"]
                }
              }
            ]
          },
          "then": {"required": ["scenario_probabilities"]}
        }
      ]
    }
  }
}
