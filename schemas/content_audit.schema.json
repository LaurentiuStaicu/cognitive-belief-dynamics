{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "as_of",
    "release_candidate",
    "purpose",
    "evidence_snapshot",
    "status_vocabulary",
    "audit_dimensions",
    "references",
    "empirical_targets",
    "variables",
    "links",
    "processes",
    "scientific_contracts",
    "repaired_findings",
    "open_gaps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "audit_id": {
      "const": "CBD.CONTENT_AUDIT.2026-09-21.r1"
    },
    "as_of": {
      "const": "2026-09-21"
    },
    "release_candidate": {
      "const": "0.1.1"
    },
    "purpose": {
      "type": "string",
      "minLength": 40
    },
    "evidence_snapshot": {
      "const": "EVIDENCE.M1.2026-09-21.r2"
    },
    "status_vocabulary": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "audit_dimensions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "references": {
      "$ref": "#/$defs/records"
    },
    "empirical_targets": {
      "$ref": "#/$defs/records"
    },
    "variables": {
      "$ref": "#/$defs/variable_records"
    },
    "links": {
      "$ref": "#/$defs/records"
    },
    "processes": {
      "$ref": "#/$defs/records"
    },
    "scientific_contracts": {
      "$ref": "#/$defs/path_records"
    },
    "repaired_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "open_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "$defs": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "checked_on": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "variable_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "short_name",
          "status",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "short_name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "path_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "status",
          "note"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "status",
        "path",
        "summary",
        "resolution"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "severity",
        "area",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "const": "OPEN_GAP"
        },
        "severity": {
          "type": "string"
        },
        "area": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
