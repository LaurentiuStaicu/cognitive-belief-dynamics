{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laurentiustaicu.github.io/cognitive-epistemic-model/schemas/workspace.schema.json",
  "title": "CEM Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","workspace_id","created_at","updated_at","versions","case","provenance"],
  "properties": {
    "schema_version": {"const": "1"},
    "workspace_id": {"type": "string", "pattern": "^CEM\\.WORKSPACE\\.[A-Za-z0-9._-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "versions": {"$ref": "#/$defs/versions"},
    "case": {"$ref": "#/$defs/case"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["software_version","model_specification","evidence_snapshot","semantic_schema_version","semantic_baseline_contract"],
      "properties": {
        "software_version": {"type": "string", "minLength": 1},
        "release_tag": {"type": "string", "minLength": 1},
        "model_specification": {"type": "string", "minLength": 1},
        "evidence_snapshot": {"type": "string", "pattern": "^EVIDENCE\\.[A-Z0-9_.-]+$"},
        "semantic_schema_version": {"type": "string", "minLength": 1},
        "semantic_baseline_contract": {"type": "string", "pattern": "^OA[0-9]+\\.BASELINE\\.[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","title","entity_refs","relation_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^CEM\\.CASE\\.[A-Za-z0-9._-]+$"},
        "title": {"type": "string", "minLength": 1},
        "notes": {"type": "string"},
        "entity_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "relation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "focus": {"$ref": "#/$defs/focus"}
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "relation_id": {"type": "string", "minLength": 1}
      },
      "minProperties": 1
    },
    "provenanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","id"],
      "properties": {
        "kind": {"enum": ["SEMANTIC_ENTITY","SEMANTIC_RELATION","WORKSPACE_REVISION","EVIDENCE_SNAPSHOT","MODEL_SPECIFICATION","SOFTWARE_VERSION"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","id"],
      "properties": {
        "kind": {"enum": ["SOFTWARE","USER_ACTION","SYSTEM"]},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","type","timestamp","agent","used","generated"],
      "properties": {
        "id": {"type": "string", "pattern": "^CEM\\.ACTIVITY\\.[A-Za-z0-9._-]+$"},
        "type": {"enum": ["CREATE","SAVE","AUTOSAVE","IMPORT","EXPORT","MIGRATE","RECOVER","UNDO","REDO"]},
        "timestamp": {"type": "string", "format": "date-time"},
        "agent": {"$ref": "#/$defs/agent"},
        "used": {"type": "array", "items": {"$ref": "#/$defs/provenanceRef"}},
        "generated": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenanceRef"}},
        "revision_of": {"type": "string", "pattern": "^CEM\\.WORKSPACE\\.REV\\.[A-Za-z0-9._-]+$"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_revision_id","activities"],
      "properties": {
        "current_revision_id": {"type": "string", "pattern": "^CEM\\.WORKSPACE\\.REV\\.[A-Za-z0-9._-]+$"},
        "activities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/activity"}}
      }
    }
  }
}
