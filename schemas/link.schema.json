{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/link.schema.json",
  "type": "object",
  "required": [
    "id",
    "source",
    "target",
    "relation_type",
    "polarity",
    "mechanism_evidence_status",
    "functional_form_status",
    "phenomenon_evidence_status",
    "evidence_refs",
    "evidence_summary",
    "evidence_limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LINK\\.[A-Z0-9_.-]+$"
    },
    "source": {
      "type": "string",
      "pattern": "^VAR\\.[A-Z0-9_.-]+$"
    },
    "target": {
      "type": "string",
      "pattern": "^VAR\\.[A-Z0-9_.-]+$"
    },
    "relation_type": {
      "enum": [
        "CAUSAL",
        "MODERATING",
        "MEDIATING",
        "MEASUREMENT",
        "OBSERVATIONAL_ASSOCIATION",
        "COMPOSITIONAL",
        "INFORMATION_FLOW",
        "INTERPRETIVE_MAPPING"
      ]
    },
    "polarity": {
      "enum": [
        "positive",
        "negative",
        "non_monotonic",
        "context_dependent",
        "unknown"
      ],
      "description": "Direction of the registered relation within its declared model/evidence scope. A positive or negative value is not, by itself, a claim of a universal empirical effect; evidence status and evidence_limitations bound generalization."
    },
    "mechanism_evidence_status": {
      "enum": [
        "REPLICATED_EXPERIMENTAL",
        "EXPERIMENTAL",
        "OBSERVATIONAL",
        "META_ANALYTIC",
        "THEORETICAL",
        "MODEL_DERIVED",
        "CANDIDATE",
        "INTERPRETIVE"
      ]
    },
    "functional_form_status": {
      "enum": [
        "EMPIRICALLY_ESTIMATED",
        "SUPPORTED_CANDIDATE",
        "REFERENCE_CANDIDATE",
        "UNSPECIFIED"
      ]
    },
    "phenomenon_evidence_status": {
      "enum": [
        "EXPERIMENTAL",
        "META_ANALYTIC",
        "OBSERVATIONAL",
        "UNREVIEWED"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REF\\.[A-Z0-9_.-]+$"
      }
    },
    "evidence_summary": {
      "type": "object",
      "required": [
        "ro",
        "en"
      ],
      "properties": {
        "ro": {
          "type": "string",
          "minLength": 10
        },
        "en": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": false
    },
    "evidence_limitations": {
      "type": "object",
      "required": [
        "ro",
        "en"
      ],
      "properties": {
        "ro": {
          "type": "string",
          "minLength": 10
        },
        "en": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
