{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laurentiustaicu.github.io/cognitive-epistemic-model/schemas/active_understanding.schema.json",
  "title": "CEM Active Understanding contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "history_schema_version",
    "history_storage_key",
    "max_history_records",
    "confidence_scale",
    "challenges"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "history_schema_version": {"const": "1"},
    "history_storage_key": {"const": "cem.active-understanding.history.v1"},
    "max_history_records": {"type": "integer", "minimum": 1, "maximum": 100},
    "confidence_scale": {
      "type": "array",
      "const": ["low", "medium", "high"]
    },
    "challenges": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/challenge"}
    }
  },
  "$defs": {
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ro", "en"],
      "properties": {
        "ro": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "label": {"$ref": "#/$defs/copy"}
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "prediction_format",
        "learning_target",
        "worked_example_refs",
        "prompt",
        "choices",
        "correct_choice_id",
        "canonical_target_refs",
        "canonical_relation_refs",
        "explanation",
        "epistemic_boundary",
        "fixture"
      ],
      "properties": {
        "id": {"enum": ["AU-1", "AU-2", "AU-3"]},
        "family": {
          "enum": [
            "EXPOSURE_VS_FAMILIARITY",
            "BELIEF_VS_SHARING",
            "COMPUTATION_VS_CAUSAL_EVIDENCE"
          ]
        },
        "prediction_format": {
          "enum": ["DIRECTION", "DIRECT_TARGET", "RELATION_LAYER"]
        },
        "learning_target": {"$ref": "#/$defs/copy"},
        "worked_example_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "prompt": {"$ref": "#/$defs/copy"},
        "choices": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/choice"}
        },
        "correct_choice_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "canonical_target_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "canonical_relation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "explanation": {"$ref": "#/$defs/copy"},
        "epistemic_boundary": {"$ref": "#/$defs/copy"},
        "fixture": {
          "oneOf": [
            {"$ref": "#/$defs/runDeltaFixture"},
            {"$ref": "#/$defs/relationTargetFixture"},
            {"$ref": "#/$defs/relationLayerFixture"}
          ]
        }
      }
    },
    "runDeltaFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "artifact_path",
        "run_id",
        "from_time",
        "to_time",
        "field",
        "expected_from",
        "expected_to"
      ],
      "properties": {
        "type": {"const": "RUN_DELTA"},
        "artifact_path": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "from_time": {"type": "integer", "minimum": 0},
        "to_time": {"type": "integer", "minimum": 0},
        "field": {"type": "string", "minLength": 1},
        "expected_from": {"type": "number"},
        "expected_to": {"type": "number"}
      }
    },
    "relationTargetFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "relation_id", "expected_target_id"],
      "properties": {
        "type": {"const": "RELATION_TARGET"},
        "relation_id": {"type": "string", "minLength": 1},
        "expected_target_id": {"type": "string", "minLength": 1}
      }
    },
    "relationLayerFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "relation_id",
        "expected_layer",
        "contrast_relation_id",
        "contrast_layer"
      ],
      "properties": {
        "type": {"const": "RELATION_LAYER"},
        "relation_id": {"type": "string", "minLength": 1},
        "expected_layer": {
          "enum": [
            "REGISTERED_EVIDENCE_RELATION",
            "COMPUTATIONAL_DEPENDENCY",
            "DOCUMENTATION_RELATION"
          ]
        },
        "contrast_relation_id": {"type": "string", "minLength": 1},
        "contrast_layer": {
          "enum": [
            "REGISTERED_EVIDENCE_RELATION",
            "COMPUTATIONAL_DEPENDENCY",
            "DOCUMENTATION_RELATION"
          ]
        }
      }
    }
  }
}
