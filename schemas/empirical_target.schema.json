{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "pattern_id",
    "evidence_ref",
    "use",
    "study",
    "effects",
    "model_match",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TARGET\\.[A-Z0-9_.-]+$"
    },
    "pattern_id": {
      "type": "string",
      "pattern": "^VAL\\.M1\\.[A-Z0-9.]+$"
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^REF\\.[A-Z0-9_.-]+$"
    },
    "provenance_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REF\\.[A-Z0-9_.-]+$"
      }
    },
    "integrity_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REF\\.[A-Z0-9_.-]+$"
      }
    },
    "counterevidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REF\\.[A-Z0-9_.-]+$"
      }
    },
    "use": {
      "enum": [
        "DIRECTIONAL_VALIDATION_ONLY",
        "MAGNITUDE_CONTEXT_ONLY"
      ]
    },
    "study": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "randomized",
            "preregistered",
            "n_recruited",
            "n_analyzed",
            "event_count"
          ],
          "properties": {
            "randomized": {
              "type": "boolean"
            },
            "preregistered": {
              "type": "boolean"
            },
            "n_recruited": {
              "type": "integer",
              "minimum": 1
            },
            "n_analyzed": {
              "type": "integer",
              "minimum": 1
            },
            "event_count": {
              "type": "integer",
              "minimum": 1
            },
            "sampling_method": {
              "type": "string",
              "minLength": 10
            },
            "sample_flow": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stage",
                  "n"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "minLength": 2
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "note": {
                    "type": "string",
                    "minLength": 5
                  }
                }
              }
            },
            "representativeness_note": {
              "type": "string",
              "minLength": 10
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "design_family",
            "randomized_assignment",
            "preregistered_analysis",
            "n_experiments",
            "n_variants",
            "n_impressions_min",
            "n_clicks"
          ],
          "properties": {
            "design_family": {
              "const": "PLATFORM_AB_TEST_ARCHIVE"
            },
            "randomized_assignment": {
              "type": "boolean"
            },
            "preregistered_analysis": {
              "type": "boolean"
            },
            "n_experiments": {
              "type": "integer",
              "minimum": 1
            },
            "n_variants": {
              "type": "integer",
              "minimum": 1
            },
            "n_impressions_min": {
              "type": "integer",
              "minimum": 1
            },
            "n_clicks": {
              "type": "integer",
              "minimum": 1
            },
            "count_note": {
              "type": "string"
            },
            "randomization_integrity_note": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      ]
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "outcome",
          "comparison"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "comparison": {
            "type": "string",
            "minLength": 1
          },
          "estimate_pp": {
            "type": "number"
          },
          "ci95": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "cohens_d": {
            "type": "number"
          },
          "metric": {
            "enum": [
              "LOG_ODDS_COEFFICIENT",
              "ODDS_RATIO",
              "RELATIVE_CHANGE_PERCENT",
              "STANDARDIZED_EFFECT",
              "DIRECTION_ONLY"
            ]
          },
          "estimate": {
            "type": "number"
          },
          "ci": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "scale_note": {
            "type": "string",
            "minLength": 10
          },
          "magnitude_use": {
            "const": "MAGNITUDE_CONTEXT_ONLY"
          }
        },
        "anyOf": [
          {
            "required": [
              "estimate_pp"
            ]
          },
          {
            "required": [
              "metric",
              "estimate",
              "scale_note",
              "magnitude_use"
            ]
          }
        ]
      }
    },
    "model_match": {
      "type": "string",
      "minLength": 10
    },
    "limitations": {
      "type": "string",
      "minLength": 10
    }
  }
}
