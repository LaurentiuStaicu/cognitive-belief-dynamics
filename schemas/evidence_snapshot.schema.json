{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "model_specification",
    "as_of",
    "registry",
    "scope"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EVIDENCE\\.M[0-9]+\\.\\d{4}-\\d{2}-\\d{2}\\.r[1-9][0-9]*$"
    },
    "model_specification": {
      "type": "string",
      "pattern": "^M[0-9]+$"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "registry": {
      "const": "model/references.json"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    }
  }
}
