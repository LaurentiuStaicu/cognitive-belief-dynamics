{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/m1_e4_discrimination_protocol.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "model_extension",
    "scope",
    "primary_route",
    "supplemental_route",
    "operating_point_rules",
    "prospective_design_simulation",
    "dataset_schema",
    "fitting_protocol",
    "winner_rule",
    "pencode_boundary",
    "sources",
    "validation_contract",
    "promotion_gate"
  ],
  "properties": {
    "id": {
      "const": "CONTRACT.M1.E4.DISCRIMINATION.2026-09-16"
    },
    "status": {
      "const": "PHASE_D_PROTOCOL_ONLY"
    },
    "model_extension": {
      "const": "M1.E4"
    },
    "scope": {
      "type": "string",
      "minLength": 40
    },
    "primary_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "minimum_operating_points_per_hsimp",
        "preferred_operating_points_per_hsimp",
        "required_bias_settings",
        "acceptable_manipulations",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "EXPERIMENTALLY_MANIPULATED_BINARY_BIAS_ROC"
        },
        "minimum_operating_points_per_hsimp": {
          "const": 3
        },
        "preferred_operating_points_per_hsimp": {
          "minimum": 5,
          "type": "integer"
        },
        "required_bias_settings": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true
        },
        "acceptable_manipulations": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "supplemental_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "preferred_scale_points",
        "nontrivial_cumulative_thresholds",
        "sole_decisive_evidence_allowed",
        "raw_category_frequencies_required",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "CONFIDENCE_RATING_ROC"
        },
        "preferred_scale_points": {
          "const": 6
        },
        "nontrivial_cumulative_thresholds": {
          "const": 5
        },
        "sole_decisive_evidence_allowed": {
          "const": false
        },
        "raw_category_frequencies_required": {
          "const": true
        },
        "reason": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "operating_point_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hard_minimum_non_degenerate_per_hsimp",
        "preferred_minimum_per_hsimp",
        "target_and_foil_observations_required",
        "false_alarm_span_required",
        "degenerate_points_count_toward_minimum",
        "universal_fixed_trial_n"
      ],
      "properties": {
        "hard_minimum_non_degenerate_per_hsimp": {
          "const": 3
        },
        "preferred_minimum_per_hsimp": {
          "minimum": 5,
          "type": "integer"
        },
        "target_and_foil_observations_required": {
          "const": true
        },
        "false_alarm_span_required": {
          "const": true
        },
        "degenerate_points_count_toward_minimum": {
          "const": false
        },
        "universal_fixed_trial_n": {
          "const": false
        }
      }
    },
    "prospective_design_simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "candidate_generators",
        "parameter_grid_must_cover",
        "minimum_core_candidate_recovery_probability",
        "threshold_status",
        "catastrophic_asymmetric_recovery_allowed"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "candidate_generators": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "parameter_grid_must_cover": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true
        },
        "minimum_core_candidate_recovery_probability": {
          "const": 0.8
        },
        "threshold_status": {
          "const": "CEM_DESIGN_CONVENTION"
        },
        "catastrophic_asymmetric_recovery_allowed": {
          "const": false
        }
      }
    },
    "dataset_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_fields",
        "confidence_metadata_required_when_applicable",
        "participant_level_preferred",
        "aggregate_counts_sufficient_for_initial_binomial_comparison"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 11,
          "uniqueItems": true
        },
        "confidence_metadata_required_when_applicable": {
          "const": true
        },
        "participant_level_preferred": {
          "const": true
        },
        "aggregate_counts_sufficient_for_initial_binomial_comparison": {
          "const": true
        }
      }
    },
    "fitting_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_surface",
        "candidate_invariance",
        "required_diagnostics",
        "single_metric_winner_allowed"
      ],
      "properties": {
        "primary_surface": {
          "const": "RAW_BINOMIAL_RESPONSE_COUNTS"
        },
        "candidate_invariance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "EVSD",
            "2HT"
          ],
          "properties": {
            "EVSD": {
              "type": "string",
              "minLength": 20
            },
            "2HT": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "required_diagnostics": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true
        },
        "single_metric_winner_allowed": {
          "const": false
        }
      }
    },
    "winner_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_allowed_only_if",
        "discordant_result",
        "universal_delta_aic_cutoff"
      ],
      "properties": {
        "selection_allowed_only_if": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true
        },
        "discordant_result": {
          "const": "INCONCLUSIVE_MODEL_DISCRIMINATION"
        },
        "universal_delta_aic_cutoff": {
          "const": false
        }
      }
    },
    "pencode_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "model_selection_identifies_pencode"
      ],
      "properties": {
        "status": {
          "const": "NOT_IDENTIFIED_AND_NOT_ACTIVE"
        },
        "model_selection_identifies_pencode": {
          "const": false
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "validation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_patterns"
      ],
      "properties": {
        "planned_patterns": {
          "type": "array",
          "minItems": 9,
          "items": {
            "$ref": "#/$defs/validation"
          }
        }
      }
    },
    "promotion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_registry_mutation_allowed",
        "runtime_model_selection_allowed",
        "winner_declaration_allowed",
        "requirements"
      ],
      "properties": {
        "active_registry_mutation_allowed": {
          "const": false
        },
        "runtime_model_selection_allowed": {
          "const": false
        },
        "winner_declaration_allowed": {
          "const": false
        },
        "requirements": {
          "type": "array",
          "minItems": 14,
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "doi",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC\\.M1\\.E4\\.PROTOCOL\\.[A-Z0-9_.-]+$"
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.\\d{4,9}/\\S+$"
        },
        "role": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "pattern"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^VAL\\.M1\\.(D01|D02|D03|D04|D05|DN01|DN02|DN03|DN04)$"
        },
        "status": {
          "const": "PLANNED_ONLY"
        },
        "pattern": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}
