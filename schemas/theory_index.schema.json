{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id","order","label","summary","source_paths","prerequisites",
    "epistemic_status","module_ids","variable_ids","mechanism_ids",
    "validation_ids","evidence_refs","sources","code_refs","related_views",
    "anchors","what_it_does_not_claim"
  ],
  "properties": {
    "id": {"type":"string","pattern":"^THEORY\\.[0-9]{2}\\.[A-Z0-9_.-]+$"},
    "order": {"type":"integer","minimum":0,"maximum":99},
    "label": {
      "type":"object","required":["en","ro"],
      "properties":{"en":{"type":"string","minLength":2},"ro":{"type":"string","minLength":2}},
      "additionalProperties":false
    },
    "summary": {
      "type":"object","required":["en","ro"],
      "properties":{"en":{"type":"string","minLength":10},"ro":{"type":"string","minLength":10}},
      "additionalProperties":false
    },
    "source_paths": {
      "type":"object","required":["en","ro"],
      "properties":{
        "en":{"type":"string","pattern":"^docs/theory/en/[a-z0-9-]+\\.md$"},
        "ro":{"type":"string","pattern":"^docs/theory/ro/[a-z0-9-]+\\.md$"}
      },
      "additionalProperties":false
    },
    "prerequisites":{"type":"array","items":{"type":"string","pattern":"^THEORY\\.[0-9]{2}\\.[A-Z0-9_.-]+$"},"uniqueItems":true},
    "epistemic_status":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"enum":["EMPIRICAL","EXECUTABLE","CONCEPTUAL","INTERPRETIVE"]}
    },
    "module_ids":{"type":"array","items":{"type":"string","pattern":"^MOD\\.[0-9]{2}$"},"uniqueItems":true},
    "variable_ids":{"type":"array","items":{"type":"string","pattern":"^(?:VAR|WM\\.VAR)\\.[A-Z0-9_.-]+$"},"uniqueItems":true},
    "mechanism_ids":{"type":"array","items":{"type":"string","pattern":"^[a-z][a-z0-9_.-]*$"},"uniqueItems":true},
    "validation_ids":{"type":"array","items":{"type":"string","pattern":"^VAL\\.[A-Z0-9_.-]+$"},"uniqueItems":true},
    "evidence_refs":{"type":"array","items":{"type":"string","pattern":"^REF\\.[A-Z0-9_.-]+$"},"uniqueItems":true},
    "sources":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["role","ref"],
        "properties":{
          "role":{"enum":["MODEL_EVIDENCE","BACKGROUND_THEORY","INTERPRETIVE_SOURCE"]},
          "ref":{"type":"string","minLength":3}
        },
        "additionalProperties":false
      }
    },
    "code_refs":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["id","path","symbol","language","release_pin_required"],
        "properties":{
          "id":{"type":"string","pattern":"^[a-z0-9_.-]+$"},
          "path":{"type":"string","pattern":"^(src|web/src)/[A-Za-z0-9_./-]+\\.(py|ts)$"},
          "symbol":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]*$"},
          "language":{"enum":["PYTHON","TYPESCRIPT"]},
          "release_pin_required":{"const":true}
        },
        "additionalProperties":false
      }
    },
    "related_views":{"type":"array","items":{"type":"string","pattern":"^[a-z][a-z0-9:._-]*$"},"uniqueItems":true},
    "anchors":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"uniqueItems":true},
    "what_it_does_not_claim":{
      "type":"object","required":["en","ro"],
      "properties":{"en":{"type":"string","minLength":10},"ro":{"type":"string","minLength":10}},
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
