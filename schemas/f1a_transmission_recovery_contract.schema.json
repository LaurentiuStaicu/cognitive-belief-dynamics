{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/f1a_transmission_recovery_contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "feedback_family",
    "purpose",
    "baseline",
    "design",
    "estimand",
    "rng_contract",
    "recovery_design",
    "structural_controls",
    "sensitivity_scope",
    "observability_boundary",
    "promotion_gate",
    "interpretation_boundary",
    "method_basis"
  ],
  "properties": {
    "id": {
      "const": "CONTRACT.F1A.TRANSMISSION_RECOVERY.2026-09-21"
    },
    "status": {
      "const": "PROSPECTIVE_SYNTHETIC_RECOVERY_DESIGN"
    },
    "feedback_family": {
      "const": "F1a"
    },
    "purpose": {
      "type": "string",
      "minLength": 80
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_release",
        "f1a_main_commit",
        "current_f1a_stage"
      ],
      "properties": {
        "public_release": {
          "const": "v0.1.1"
        },
        "f1a_main_commit": {
          "const": "88921e63a45eff0c4be75a902ebcb8a4097ef546"
        },
        "current_f1a_stage": {
          "const": "SYNTHETIC_EXECUTABLE"
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_config",
        "implementation_module",
        "runner",
        "result_path",
        "active_runtime_policy_change_allowed",
        "result_must_not_predate_this_contract"
      ],
      "properties": {
        "core_config": {
          "const": "model/benchmarks/f1a_transmission_recovery_core.json"
        },
        "implementation_module": {
          "const": "src/cognitive_epistemic_model/calibration/f1a_transmission_recovery.py"
        },
        "runner": {
          "const": "scripts/run_f1a_transmission_recovery.py"
        },
        "result_path": {
          "const": "model/benchmarks/results/f1a_transmission_recovery_authoritative_2026-09-21.json"
        },
        "active_runtime_policy_change_allowed": {
          "const": false
        },
        "result_must_not_predate_this_contract": {
          "const": true
        }
      }
    },
    "estimand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mathematical_role",
        "denominator",
        "numerator",
        "jointly_estimates_share_propensity",
        "empirical_interpretation_allowed"
      ],
      "properties": {
        "name": {
          "const": "q_transmit"
        },
        "mathematical_role": {
          "type": "string",
          "minLength": 40
        },
        "denominator": {
          "const": "realised Share-edge opportunities"
        },
        "numerator": {
          "const": "realised endogenous recipient ExposureEvents generated by the recovery-only policy"
        },
        "jointly_estimates_share_propensity": {
          "const": false
        },
        "empirical_interpretation_allowed": {
          "const": false
        }
      }
    },
    "rng_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transmission_rng_isolated_from_cognitive_rng",
        "deterministic_seed_derivation_required",
        "same_seed_reproducible",
        "benchmark_iteration_order_must_not_change_cell_random_streams"
      ],
      "properties": {
        "transmission_rng_isolated_from_cognitive_rng": {
          "const": true
        },
        "deterministic_seed_derivation_required": {
          "const": true
        },
        "same_seed_reproducible": {
          "const": true
        },
        "benchmark_iteration_order_must_not_change_cell_random_streams": {
          "const": true
        }
      }
    },
    "recovery_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimator",
        "q_grid",
        "core_opportunity_counts",
        "stress_opportunity_counts",
        "delay_factors",
        "absolute_error_tolerance",
        "minimum_core_cell_recovery_probability",
        "replicates_per_cell",
        "stress_cells_are_non_gating"
      ],
      "properties": {
        "estimator": {
          "const": "BINOMIAL_MLE"
        },
        "q_grid": {
          "type": "array",
          "const": [
            0.1,
            0.25,
            0.5,
            0.75,
            0.9
          ]
        },
        "core_opportunity_counts": {
          "type": "array",
          "const": [
            50,
            100
          ]
        },
        "stress_opportunity_counts": {
          "type": "array",
          "const": [
            25
          ]
        },
        "delay_factors": {
          "type": "array",
          "const": [
            1,
            4
          ]
        },
        "absolute_error_tolerance": {
          "const": 0.1
        },
        "minimum_core_cell_recovery_probability": {
          "const": 0.8
        },
        "replicates_per_cell": {
          "const": 200
        },
        "stress_cells_are_non_gating": {
          "const": true
        }
      }
    },
    "structural_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q_zero_exact_no_transmission",
        "q_one_exact_full_transmission",
        "q_one_matches_forced_pass_through_exposure_count",
        "delay_changes_timing_not_complete_horizon_exposure_count",
        "final_familiarity_must_equal_existing_update_from_realised_exposure_count"
      ],
      "properties": {
        "q_zero_exact_no_transmission": {
          "const": true
        },
        "q_one_exact_full_transmission": {
          "const": true
        },
        "q_one_matches_forced_pass_through_exposure_count": {
          "const": true
        },
        "delay_changes_timing_not_complete_horizon_exposure_count": {
          "const": true
        },
        "final_familiarity_must_equal_existing_update_from_realised_exposure_count": {
          "const": true
        }
      }
    },
    "sensitivity_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_parameter",
        "design_factors",
        "expected_relations",
        "global_variance_decomposition_required",
        "rationale"
      ],
      "properties": {
        "primary_parameter": {
          "const": "q_transmit"
        },
        "design_factors": {
          "type": "array",
          "const": [
            "opportunity_count",
            "abstract_delay"
          ]
        },
        "expected_relations": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 30
          }
        },
        "global_variance_decomposition_required": {
          "const": false
        },
        "rationale": {
          "type": "string",
          "minLength": 60
        }
      }
    },
    "observability_boundary": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 40
      }
    },
    "promotion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_stage",
        "candidate_stage_after_authoritative_pass",
        "automatic_promotion_allowed",
        "core_config_frozen_before_authoritative_result",
        "requirements"
      ],
      "properties": {
        "current_stage": {
          "const": "SYNTHETIC_EXECUTABLE"
        },
        "candidate_stage_after_authoritative_pass": {
          "const": "RECOVERY_TESTED"
        },
        "automatic_promotion_allowed": {
          "const": false
        },
        "core_config_frozen_before_authoritative_result": {
          "const": true
        },
        "requirements": {
          "type": "array",
          "minItems": 13,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "interpretation_boundary": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 40
      }
    },
    "method_basis": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^METHOD\\.[A-Z0-9_.-]+$"
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\.\\d{4,9}/\\S+$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://\\S+$"
          },
          "role": {
            "type": "string",
            "minLength": 30
          }
        },
        "anyOf": [
          {
            "required": [
              "doi"
            ]
          },
          {
            "required": [
              "url"
            ]
          }
        ]
      }
    }
  }
}
