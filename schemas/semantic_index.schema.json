{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laurentiustaicu.github.io/cognitive-epistemic-model/schemas/semantic_index.schema.json",
  "title": "CEM Semantic Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_contract",
    "source_paths",
    "entities",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "baseline_contract": {
      "type": "string",
      "pattern": "^OA[0-9]+\\.BASELINE\\.[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "$defs": {
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred"
      ],
      "properties": {
        "preferred": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "ro": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            },
            "und": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "alternative": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ro": {
              "$ref": "#/$defs/labelList"
            },
            "en": {
              "$ref": "#/$defs/labelList"
            },
            "und": {
              "$ref": "#/$defs/labelList"
            }
          }
        }
      }
    },
    "labelList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "statusFacets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "CONCEPTUAL",
              "EMPIRICAL",
              "EXECUTABLE",
              "INTERPRETIVE"
            ]
          }
        },
        "phenomenon_evidence": {
          "enum": [
            "EXPERIMENTAL",
            "META_ANALYTIC",
            "OBSERVATIONAL",
            "UNREVIEWED"
          ]
        },
        "mechanism_evidence": {
          "enum": [
            "REPLICATED_EXPERIMENTAL",
            "EXPERIMENTAL",
            "OBSERVATIONAL",
            "META_ANALYTIC",
            "THEORETICAL",
            "MODEL_DERIVED",
            "CANDIDATE",
            "INTERPRETIVE"
          ]
        },
        "functional_form": {
          "enum": [
            "EMPIRICALLY_ESTIMATED",
            "SUPPORTED_CANDIDATE",
            "REFERENCE_CANDIDATE",
            "UNSPECIFIED"
          ]
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "semantic_type",
        "labels",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_type": {
          "enum": [
            "VARIABLE",
            "MODULE",
            "REFERENCE",
            "VALIDATION",
            "EMPIRICAL_TARGET",
            "THEORY_CHAPTER",
            "GLOSSARY_ENTRY"
          ]
        },
        "semantic_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "MECHANISM_DESCRIPTOR",
              "CONCEPT_DESCRIPTOR"
            ]
          }
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "status_facets": {
          "$ref": "#/$defs/statusFacets"
        },
        "short_name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ro": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            },
            "und": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "related_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "relation": {
      "oneOf": [
        {
          "$ref": "#/$defs/registeredEvidenceRelation"
        },
        {
          "$ref": "#/$defs/computationalDependency"
        },
        {
          "$ref": "#/$defs/documentationRelation"
        }
      ]
    },
    "relationBase": {
      "type": "object",
      "required": [
        "id",
        "layer",
        "source",
        "target",
        "source_record"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "enum": [
            "REGISTERED_EVIDENCE_RELATION",
            "COMPUTATIONAL_DEPENDENCY",
            "DOCUMENTATION_RELATION"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "source_record": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "registeredEvidenceRelation": {
      "allOf": [
        {
          "$ref": "#/$defs/relationBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "layer",
            "source",
            "target",
            "source_record",
            "relation_type",
            "polarity",
            "status_facets",
            "evidence_refs"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^LINK\\.[A-Z0-9_.-]+$"
            },
            "layer": {
              "const": "REGISTERED_EVIDENCE_RELATION"
            },
            "source": {
              "type": "string",
              "pattern": "^VAR\\.[A-Z0-9_.-]+$"
            },
            "target": {
              "type": "string",
              "pattern": "^VAR\\.[A-Z0-9_.-]+$"
            },
            "source_record": {
              "$ref": "#/$defs/source"
            },
            "relation_type": {
              "enum": [
                "CAUSAL",
                "MODERATING",
                "MEDIATING",
                "MEASUREMENT",
                "OBSERVATIONAL_ASSOCIATION",
                "COMPOSITIONAL",
                "INFORMATION_FLOW",
                "INTERPRETIVE_MAPPING"
              ]
            },
            "polarity": {
              "enum": [
                "positive",
                "negative",
                "non_monotonic",
                "context_dependent",
                "unknown"
              ]
            },
            "status_facets": {
              "$ref": "#/$defs/statusFacets"
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^REF\\.[A-Z0-9_.-]+$"
              }
            }
          }
        }
      ]
    },
    "computationalDependency": {
      "allOf": [
        {
          "$ref": "#/$defs/relationBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "layer",
            "source",
            "target",
            "source_record",
            "formula",
            "code_file"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "layer": {
              "const": "COMPUTATIONAL_DEPENDENCY"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "source_record": {
              "$ref": "#/$defs/source"
            },
            "formula": {
              "type": "string",
              "minLength": 1
            },
            "code_file": {
              "type": "string",
              "minLength": 1
            },
            "registered_relation_id": {
              "type": "string",
              "pattern": "^LINK\\.[A-Z0-9_.-]+$"
            }
          }
        }
      ]
    },
    "documentationRelation": {
      "allOf": [
        {
          "$ref": "#/$defs/relationBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "layer",
            "source",
            "target",
            "source_record",
            "relation_type"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^SEMREL\\.DOC\\.[A-Z0-9_.-]+$"
            },
            "layer": {
              "const": "DOCUMENTATION_RELATION"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "source_record": {
              "$ref": "#/$defs/source"
            },
            "relation_type": {
              "enum": [
                "USES_MODULE",
                "USES_VARIABLE",
                "DESCRIBES_MECHANISM",
                "REFERENCES_VALIDATION",
                "CITES_REFERENCE",
                "PREREQUISITE_CHAPTER",
                "RELATED_CHAPTER"
              ]
            }
          }
        }
      ]
    }
  }
}
