{
  "name": "cognitive-epistemic-model-web",
  "private": true,
  "version": "0.4.2-alpha.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:workspace && npm run test:ia && npm run test:visual && npm run test:oa4 && tsc --noEmit && vite build --base=./",
    "prebuild": "node scripts/sync-model.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node scripts/smoke.mjs",
    "predev": "node scripts/sync-model.mjs",
    "test:workspace": "node --test tests/workspace-*.test.ts",
    "test:ia": "node --test tests/navigation.test.ts",
    "test:visual": "node --test tests/visual-language.test.ts",
    "test:oa4": "node --test tests/search-inspector.test.ts"
  },
  "dependencies": {
    "cytoscape": "^3.31.0",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "playwright": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
